<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#16131e">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tv_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TOPDON INFRARED + GSR"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Multi-Modal Physiological Sensing Platform"
            android:textSize="14sp"
            android:textColor="#CCFFFFFF"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/tv_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Connection Status Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_connection_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#2A2636"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/img_connection_status"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_error"
                    app:tint="#FF6B6B"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_connection_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="No GSR sensor connected"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/img_connection_status"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/img_connection_status"
                    app:layout_constraintBottom_toBottomOf="@id/img_connection_status" />

                <TextView
                    android:id="@+id/tv_recording_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Ready to record"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="@id/img_connection_status"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_connection_status" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Device Discovery Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_device_discovery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#2A2636"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/card_connection_status"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_device_discovery_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="GSR Device Discovery"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <Button
                    android:id="@+id/btn_scan_devices"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Scan for Shimmer Devices"
                    android:textColor="@color/white"
                    android:backgroundTint="#FF6B35"
                    app:layout_constraintTop_toBottomOf="@id/tv_device_discovery_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ProgressBar
                    android:id="@+id/progress_connection"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/btn_scan_devices"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_device_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Tap scan to discover GSR devices"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/progress_connection"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ListView
                    android:id="@+id/device_list"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="12dp"
                    android:background="#1A1824"
                    android:divider="#3A3644"
                    android:dividerHeight="1dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_device_status"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Recording Controls Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_recording_controls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#2A2636"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/card_device_discovery"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_recording_controls_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="GSR Recording Controls"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <Button
                    android:id="@+id/btn_start_recording"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Start GSR Recording"
                    android:textColor="@color/white"
                    android:backgroundTint="#4CAF50"
                    android:enabled="false"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_recording_controls_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_stop_recording" />

                <Button
                    android:id="@+id/btn_stop_recording"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Stop Recording"
                    android:textColor="@color/white"
                    android:backgroundTint="#F44336"
                    android:enabled="false"
                    android:layout_marginStart="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_recording_controls_title"
                    app:layout_constraintStart_toEndOf="@id/btn_start_recording"
                    app:layout_constraintEnd_toEndOf="parent" />

                <Button
                    android:id="@+id/btn_disconnect_gsr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Disconnect GSR Sensor"
                    android:textColor="@color/white"
                    android:backgroundTint="#757575"
                    android:enabled="false"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/btn_start_recording"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_session_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Session: none"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/btn_disconnect_gsr"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Sensor Information Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_sensor_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2A2636"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/card_recording_controls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_sensor_info_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Sensor Information"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_sensor_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="No sensor connected"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/tv_sensor_info_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>